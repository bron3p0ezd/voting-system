FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --timing --verbose --no-audit --no-fund

COPY . .

ARG VITE_USE_USER_MOCKS
ARG VITE_SERVERS_API_URL
ARG VITE_DEV_ALLOWED_HOSTS
ARG VITE_DEV_HOST
ARG VITE_DEV_PORT

ENV VITE_USE_USER_MOCKS=$VITE_USE_USER_MOCKS
ENV VITE_SERVERS_API_URL=$VITE_SERVERS_API_URL
ENV VITE_DEV_ALLOWED_HOSTS=$VITE_DEV_ALLOWED_HOSTS
ENV VITE_DEV_HOST=$VITE_DEV_HOST
ENV VITE_DEV_PORT=$VITE_DEV_PORT

CMD ["npm", "run", "build"]
